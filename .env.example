# Copy to .env.local and fill in from Supabase: Project Settings -> API
# The anon key is public by design; the real protection is Row Level Security in the database.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: your support WhatsApp number in international format without +, e.g. 201012345678
VITE_SUPPORT_WHATSAPP=
# Secret path of the admin panel (no slashes). Use a long random string, e.g. run:  openssl rand -hex 12
# Leave empty to disable the admin panel completely.
VITE_ADMIN_PATH=

# Shown in the Terms and Privacy pages. Fill before launch.
VITE_LEGAL_ENTITY=
VITE_LEGAL_CONTACT=
# Where the database servers are (e.g. Frankfurt). Must match your Supabase project region.
VITE_DATA_REGION=

# Old activation-code mode (pilot). Leave unset: the platform now works with accounts approved from the admin panel.
# VITE_ALLOW_LICENSE_MODE=true
